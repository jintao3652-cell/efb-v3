# Optional: enables OpenWeather data in the desktop weather page.
OPENWEATHER_API_KEY=your_openweather_api_key

# Optional: enables Mapbox raster tiles. The app falls back to OpenStreetMap without it.
VITE_MAPBOX_ACCESS_TOKEN=your_public_mapbox_access_token

# 可选：XFlySim 接口反代目标，默认 https://api.xflysim.com
# 桌面端由 Rust 侧 api_proxy 直接转发，不受此变量影响；这里只作用于 Vite 的 /xapi 反代。
VITE_XFLY_TARGET=https://api.xflysim.com

# 可选：覆盖底图样式地址（默认 OpenFreeMap 的 Positron / Dark）
# VITE_BASEMAP_LIGHT=
# VITE_BASEMAP_DARK=

# 可选：OpenWeather 降水雷达瓦片，留空则不显示天气雷达图层
# VITE_OPENWEATHER_API_KEY=

# 可选：仅作用于 Vite 的 /jepp 反代（浏览器调试用）。
# 正式包的服务地址与令牌写死在 src-tauri/src/commands/jepp.rs，前端产物里
# 既没有域名也没有令牌；要换服务 / 轮换令牌只能改那一处并重新打包。
# VITE_JEPP_TARGET=http://jepp.example.com:8773
# VITE_JEPP_TOKEN=
